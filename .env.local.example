# .env.local - Local Environment Configuration
# Copy this file to .env.local and customize for your local machine
# NEVER commit this file to version control - it contains sensitive credentials

# Transmission RPC Configuration
TRANSMISSION_HOST=localhost
TRANSMISSION_PORT=9091
TRANSMISSION_USER=your_local_username
TRANSMISSION_PASS=your_local_password

# Local-specific settings
# Override any development settings here
# LOG_LEVEL=INFO

# Logging (optional)
# Uncomment to log to a file (default: console only)
# LOG_FILE=/var/log/linux-iso-updater.log
# LOG_FILE=~/logs/iso-updater.log

# Distributions to update (override development/production settings)
# Options: centos, debian, ubuntu, arch, raspberrypi, mint, fedora, popos, rocky, alma, manjaro, elementary, zorin, endeavour
# Examples:
#   DISTROS=debian          # Only Debian
#   DISTROS=debian,ubuntu   # Debian and Ubuntu only
#   DISTROS=                # Empty = use default (all)
# DISTROS=debian

# Example: Use different Transmission instance for local testing
# TRANSMISSION_HOST=127.0.0.1
# TRANSMISSION_PORT=9091

# Example: Test with remote Transmission server
# TRANSMISSION_HOST=192.168.1.50
# TRANSMISSION_PORT=9091
# TRANSMISSION_USER=admin
# TRANSMISSION_PASS=secure_password

# Web Interface Configuration
# Enable/disable the web interface (Flask server on port 8084)
# Default: false (runs in CLI mode for one-time checks)
# Set to "true" to run the web server (required for web UI and automatic scheduling)
# Examples:
#   WEB_ENABLED=true        # Enable web interface (for GUI management)
#   WEB_ENABLED=false       # Disable web interface (CLI mode only)
# WEB_ENABLED=true

# Automatic Scheduling Configuration
# Enable/disable automatic torrent checks
# NOTE: Only works when WEB_ENABLED=true (requires web interface to run)
# Examples:
#   SCHEDULE_ENABLED=true        # Enable automatic checks (default)
#   SCHEDULE_ENABLED=false       # Disable automatic checks
# SCHEDULE_ENABLED=true

# Frequency for automatic checks
# Options: 1h, 8h, 1d, 7d, 14d, 30d
# Examples:
#   SCHEDULE_FREQUENCY=1h        # Check every hour
#   SCHEDULE_FREQUENCY=8h        # Check every 8 hours
#   SCHEDULE_FREQUENCY=1d        # Check daily (default)
#   SCHEDULE_FREQUENCY=7d        # Check weekly
# SCHEDULE_FREQUENCY=1d

# Time to run automatic checks (24-hour format HH:MM)
# Only used when SCHEDULE_FREQUENCY is set to 1d or longer
# Examples:
#   SCHEDULE_TIME=02:00      # Run at 2am (default)
#   SCHEDULE_TIME=14:30      # Run at 2:30pm
# SCHEDULE_TIME=02:00

# Default selected distributions in web interface (comma-separated)
# SELECT_DISTROS=debian,ubuntu,arch,fedora,mint,rocky

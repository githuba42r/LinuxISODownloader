# .env.local - Local Environment Configuration
# Copy this file to .env.local and customize for your local machine
# NEVER commit this file to version control - it contains sensitive credentials

# Transmission RPC Configuration
TRANSMISSION_HOST=localhost
TRANSMISSION_PORT=9091
TRANSMISSION_USER=your_local_username
TRANSMISSION_PASS=your_local_password

# Local-specific settings
# Override any development settings here
# LOG_LEVEL=INFO

# Logging (optional)
# Uncomment to log to a file (default: console only)
# LOG_FILE=/var/log/linux-iso-updater.log
# LOG_FILE=~/logs/iso-updater.log

# Distributions to update (override development/production settings)
# Examples:
#   DISTROS=debian          # Only Debian
#   DISTROS=debian,ubuntu   # Debian and Ubuntu only
#   DISTROS=                # Empty = use default (all)
# DISTROS=debian

# Example: Use different Transmission instance for local testing
# TRANSMISSION_HOST=127.0.0.1
# TRANSMISSION_PORT=9091

# Example: Test with remote Transmission server
# TRANSMISSION_HOST=192.168.1.50
# TRANSMISSION_PORT=9091
# TRANSMISSION_USER=admin
# TRANSMISSION_PASS=secure_password

# Automatic Scheduling (Web Interface Only)
# Time to automatically check for torrent updates (24-hour format HH:MM)
# Examples:
#   SCHEDULE_TIME=02:00      # Run at 2am (default)
#   SCHEDULE_TIME=14:30      # Run at 2:30pm
#   SCHEDULE_TIME=disabled   # Disable automatic checks
# SCHEDULE_TIME=02:00

# Distributions for scheduled checks (comma-separated)
# SCHEDULE_DISTROS=debian,ubuntu,arch

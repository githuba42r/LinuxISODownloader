# .env.development - Development Environment Configuration
# Copy this file to .env.development and customize for your development setup
# This file can be committed to version control

# Transmission RPC Configuration
TRANSMISSION_HOST=localhost
TRANSMISSION_PORT=9091
TRANSMISSION_USER=development_user
TRANSMISSION_PASS=development_password

# Development-specific settings
# Set to 'DEBUG' for verbose logging during development
LOG_LEVEL=DEBUG

# Logging (optional)
# Uncomment to log to a file during development
# LOG_FILE=~/logs/iso-updater-dev.log

# Distributions to update during development
# Only test with smaller, faster distributions during development
DISTROS=debian,ubuntu,raspberrypi

# Optional: Use a test Transmission instance
# TRANSMISSION_HOST=192.168.1.100
# TRANSMISSION_PORT=9092

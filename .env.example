# Transmission RPC Configuration
TRANSMISSION_HOST=localhost
TRANSMISSION_PORT=9091
TRANSMISSION_USER=your_transmission_username
TRANSMISSION_PASS=your_transmission_password

# Distributions to update (comma-separated list)
# Options: centos, debian, ubuntu, arch, raspberrypi, mint, fedora, popos, rocky, alma, manjaro, elementary, zorin, endeavour
# Leave empty or comment out to update all distributions
DISTROS=debian,ubuntu,arch,centos,raspberrypi

# Logging Configuration (optional)
# Path to log file. If not set, logs only to console.
# Examples: /var/log/linux-iso-updater.log or ~/logs/iso-updater.log
#LOG_FILE=

# Automatic Scheduling (Web Interface Only)
# Time to automatically check for torrent updates (24-hour format HH:MM)
# Default: 02:00 (2am local time)
# Use "disabled" to disable automatic checks
SCHEDULE_TIME=02:00

# Default selected distributions in web interface (comma-separated)
# These distros will be pre-selected when you open the web interface
# Options: centos, debian, ubuntu, arch, raspberrypi, mint, fedora, popos, rocky, alma, manjaro, elementary, zorin, endeavour
# Default: all distributions
# Use "disabled" to select none by default
SELECT_DISTROS=debian,ubuntu,arch,fedora,mint,rocky

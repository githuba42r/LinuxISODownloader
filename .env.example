# Transmission RPC Configuration
TRANSMISSION_HOST=localhost
TRANSMISSION_PORT=9091
TRANSMISSION_USER=your_transmission_username
TRANSMISSION_PASS=your_transmission_password

# Distributions to update (comma-separated list)
# Options: centos, debian, ubuntu, arch, raspberrypi, mint, fedora, popos, rocky, alma, manjaro, elementary, zorin, endeavour
# Leave empty or comment out to update all distributions
DISTROS=debian,ubuntu,arch,centos,raspberrypi

# Logging Configuration (optional)
# Path to log file. If not set, logs only to console.
# Examples: /var/log/linux-iso-updater.log or ~/logs/iso-updater.log
#LOG_FILE=

# Web Interface Configuration
# Enable/disable the web interface (Flask server on port 8084)
# Default: false (runs in CLI mode for one-time checks)
# Set to "true" to run the web server (required for web UI and automatic scheduling)
WEB_ENABLED=false

# Automatic Scheduling Configuration
# Enable/disable automatic torrent checks
# Default: true
# Set to "false" or "disabled" to disable automatic checks
# NOTE: Only works when WEB_ENABLED=true (requires web interface to run)
SCHEDULE_ENABLED=true

# Frequency for automatic checks
# Options: 1h, 8h, 1d, 7d, 14d, 30d
# Default: 1d (once per day)
# 1h = every hour, 8h = every 8 hours, 1d = daily, 7d = weekly, 14d = biweekly, 30d = monthly
SCHEDULE_FREQUENCY=1d

# Time to run automatic checks (24-hour format HH:MM)
# Only used when SCHEDULE_FREQUENCY is set to a daily or longer interval
# Default: 02:00 (2am local time)
# For intervals shorter than 1 day, the first check runs immediately and subsequent checks follow the frequency
SCHEDULE_TIME=02:00

# Default selected distributions in web interface (comma-separated)
# These distros will be pre-selected when you open the web interface
# Options: centos, debian, ubuntu, arch, raspberrypi, mint, fedora, popos, rocky, alma, manjaro, elementary, zorin, endeavour
# Default: all distributions
# Use "disabled" to select none by default
SELECT_DISTROS=debian,ubuntu,arch,fedora,mint,rocky
